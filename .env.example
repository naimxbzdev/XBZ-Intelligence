# ==============================================================================
# XBZ Intelligence — Environment Variables Template (.env.example)
# Platform: Bangladesh Courier Fraud Screening & Delivery Risk Analysis
# Copy this file to .env before starting the server:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
# Port for the Node.js / Express backend server (default: 3000)
PORT=3000

# Node environment mode: 'development' or 'production'
NODE_ENV=development

# Application base URL (used for self-referential links, embeds, and callbacks)
# Development: http://localhost:3000
# Production: https://your-domain.com or Cloud Run URL
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI API (Optional)
# ------------------------------------------------------------------------------
# Required for Gemini AI risk summary enhancements and smart recommendations.
# In Google AI Studio, this is automatically injected at runtime.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. SMARTPOS FRAUD ENGINE (Central Gateway)
# ------------------------------------------------------------------------------
# SmartPOS Fraud Checker REST API key (X-API-KEY header).
# Format: fraud_live_... or partner key
# If left empty, the engine falls back to 15-day smart cache and deterministic heuristics.
SMARTPOS_FRAUD_API_KEY=fraud_vRSyppIMF080gu4VE1TYRDqHsYIPL0Ms

# Optional domain locking header (X-Domain).
# Required only if your merchant API key has domain lock enabled.
SMARTPOS_DOMAIN=

# ------------------------------------------------------------------------------
# 4. DIRECT COURIER CREDENTIALS (Optional Overrides)
# ------------------------------------------------------------------------------
# If you have direct merchant contracts with couriers, configure them here:

# Steadfast Courier (portal.steadfast.com.bd)
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# Pathao Courier (developer.pathao.com)
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=

# REDX Delivery (openapi.redx.com.bd)
REDX_API_TOKEN=

# CarryBee Express
CARRYBEE_API_KEY=

# Paperfly Wings Doorstep Courier
PAPERFLY_KEY=

# ------------------------------------------------------------------------------
# 5. RUNTIME BEHAVIOR
# ------------------------------------------------------------------------------
# Enable sandbox / simulated demo data when external couriers are unreachable.
# Options: 'true' (fallback active) or 'false' (live network queries only)
ENABLE_SANDBOX=false
